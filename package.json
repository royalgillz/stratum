    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
